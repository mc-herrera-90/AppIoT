<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="48dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_menu_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Fotografía -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="110dp"
                android:layout_height="110dp"
                app:cardCornerRadius="55dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivMarco"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Fotografía de Marco Contreras"
                    android:scaleType="centerCrop" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Nombre -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/outfit_bold"
                android:text="Marco Contreras"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Rol -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/outfit_semibold"
                android:text="Full Stack Developer"
                android:textAlignment="center"
                android:textColor="@color/primary"
                android:textSize="14sp" />

            <!-- Sitio web -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit_regular"
                android:text="mcherrera.dev"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />


            <!-- Botón GitHub -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGithubMarco"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/outfit_semibold"
                android:text="GitHub"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="0dp"
                app:icon="@drawable/ic_github"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

        </LinearLayout>



    </LinearLayout>

</ScrollView>
