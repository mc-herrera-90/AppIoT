<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="48dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:fontFamily="@font/outfit_bold"
            android:text="Gestión de usuarios"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="35dp"
            android:fontFamily="@font/outfit_regular"
            android:text="Administra los usuarios registrados en MCIOT."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Ingresar usuario -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddUser"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:fontFamily="@font/outfit_semibold"
            android:text="INGRESAR USUARIO"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="#829416"
            app:cornerRadius="0dp"
            app:icon="@drawable/ic_person_add"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:iconSize="20dp" />

        <!-- Listar usuarios -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListUsers"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/outfit_semibold"
            android:text="LISTAR USUARIOS"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="#829416"
            app:cornerRadius="0dp"
            app:icon="@drawable/ic_group"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:iconSize="20dp" />

    </LinearLayout>
</ScrollView>
