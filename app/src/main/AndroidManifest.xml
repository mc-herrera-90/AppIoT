<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppIoT">

        <!-- Pantalla inicial -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppIoT"
            android:clearTaskOnLaunch="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Inicio de sesión -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <!-- Actividad principal -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Registro -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <!-- Tabla CRUD -->
        <activity
            android:name=".activities.UserManagementActivity"
            android:exported="false" />

        <!-- Listar usuarios -->
        <activity
            android:name=".activities.UserListActivity"
            android:exported="false" />

        <!-- Editar usuarios -->
        <activity
            android:name=".activities.UserEditActivity"
            android:exported="false" />

        <!-- Sensores -->
        <activity
            android:name=".activities.SensorsActivity"
            android:exported="false" />

        <!-- Desarrolladores -->
        <activity
            android:name=".activities.DevelopersActivity"
            android:exported="false" />

        <!-- Recuperar contraseña -->
        <activity
            android:name=".activities.RecoverPasswordActivity"
            android:exported="false" />

    </application>

</manifest>
